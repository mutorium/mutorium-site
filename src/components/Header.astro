---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
	<nav>
		<div class="nav-left">
			<h2><a href="/">{SITE_TITLE}</a></h2>
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/book/mutation-testing">Book</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
		</div>

		<div class="nav-right">
			<ThemeToggle />
			<div class="social-links">
				<a
					href="https://x.com/mutoriumlabs"
					target="_blank"
					rel="noreferrer"
				>
					<span class="sr-only">Follow Mutorium Labs on X</span>
					<svg
						viewBox="0 0 300 271"
						aria-hidden="true"
						width="32"
						height="32"
						class="icon-x"
					>
						<path
							fill="currentColor"
							d="m236 0h46l-101 115 118 156h-92.6l-72.5-94.8-83 94.8h-46l107-123-113-148h94.9l65.5 86.6zm-16.1 244h25.5l-165-218h-27.4z"
						></path>
					</svg>
				</a>
				<a href="https://github.com/mutorium" target="_blank">
					<span class="sr-only">Go to Mutorium Labs GitHub</span>
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
						width="32"
						height="32"
						astro-icon="social/github"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background-color: var(--header-bg);
		color: var(--header-text);
		border-bottom: 1px solid rgba(148, 163, 184, 0.18);
		box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px; /* keeps things centered on desktop */
		margin: 0 auto;
		padding: 0.5rem 0;
	}

	.nav-left {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	h2 {
		margin: 0;
		font-size: 1rem;
	}

	h2 a {
		text-decoration: none;
		color: var(--header-text);
		font-weight: 700;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	nav a {
		padding: 1rem 0.5rem;
		color: var(--header-text);
		border-bottom: 3px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		border-bottom-color: var(--accent);
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.social-links a {
		color: var(--header-text);
	}

	.social-links a:hover {
		color: var(--accent);
	}

	/* -------- Mobile layout adjustments -------- */
	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}

		nav {
			flex-direction: column;
			align-items: stretch;
			gap: 0.35rem;
		}

		.nav-left {
			justify-content: space-between;
		}

		h2 {
			font-size: 0.95rem;
		}

		.internal-links {
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.5rem;
			font-size: 0.9rem;
		}

		.nav-right {
			justify-content: center;
		}

		/* keep header compact on mobile */
		nav a {
			padding: 0.6rem 0.4rem;
		}

		/* hide social icons on small screens to reduce clutter */
		.social-links {
			display: none;
		}
	}
</style>

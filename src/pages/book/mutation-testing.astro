---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";

const pageTitle = "The Mutorium Labs Book of Mutation Testing";
const pageDescription =
    "A living, practical book on mutation testing – work in progress by Mutorium Labs.";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${pageTitle} | ${SITE_TITLE}`}
            description={pageDescription || SITE_DESCRIPTION}
        />
    </head>
    <body>
        <Header />
        <main>
            <section class="hero">
                <h1>{pageTitle}</h1>
                <p class="tagline">
                    A programmer-focused book on mutation testing – from
                    fundamentals to Rust, Solidity, and ZK circuits.
                </p>
                <p>
                    This is a <strong>work in progress</strong>. Chapters will
                    be published as blog posts first. Once more content is live,
                    this page will become a proper table of contents.
                </p>
            </section>

            <section class="section">
                <h2>Published chapters</h2>
                <ul>
                    <li>
                        <a href="/blog/what-is-mutation-testing/">
                            What Is Mutation Testing?
                        </a>
                    </li>
                    <li>
                        <a href="/blog/swiss-cheese-model-of-web3/">
                            Swiss Cheese Model of Web3 Security
                        </a>
                    </li>
                </ul>
            </section>
        </main>
        <Footer />
    </body>
</html>
